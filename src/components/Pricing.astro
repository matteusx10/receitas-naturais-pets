---
---

<section id="precos" class="pricing">
  <div class="pricing-bg">
    <div class="pricing-orb-1" data-parallax="-0.08"></div>
    <div class="pricing-orb-2" data-parallax="0.05"></div>
  </div>
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">💎 Oferta Especial</span>
      <h2 class="section-title">Invista na saúde<br/><span class="gradient-text">do seu pet</span></h2>
      <p class="section-subtitle">
        Escolha o plano ideal e comece hoje mesmo a transformar a alimentação do seu melhor amigo.
      </p>
    </div>
    <div class="pricing-grid stagger reveal">
      <div class="pricing-card">
        <div class="pricing-header">
          <h3 class="pricing-name">Básico</h3>
          <div class="pricing-price">
            <span class="currency">R$</span>
            <span class="amount">47</span>
            <span class="cents">,90</span>
          </div>
          <span class="pricing-period">Pagamento único</span>
        </div>
        <ul class="pricing-features">
          <li><span class="check">✓</span> 50 receitas selecionadas</li>
          <li><span class="check">✓</span> Lista de ingredientes</li>
          <li><span class="check">✓</span> Modo de preparo completo</li>
          <li><span class="check">✓</span> Acesso vitalício</li>
          <li class="disabled"><span class="check">✕</span> Receitas medicinais</li>
          <li class="disabled"><span class="check">✕</span> Suporte veterinário</li>
        </ul>
        <a href="#" class="btn btn-secondary pricing-btn">Começar Agora</a>
      </div>

      <div class="pricing-card featured">
        <div class="pricing-badge">Mais Popular</div>
        <div class="featured-glow"></div>
        <div class="pricing-header">
          <h3 class="pricing-name">Completo</h3>
          <div class="pricing-price">
            <span class="currency">R$</span>
            <span class="amount">97</span>
            <span class="cents">,90</span>
          </div>
          <span class="pricing-period">Pagamento único</span>
          <span class="original-price">De R$ 197,00</span>
        </div>
        <ul class="pricing-features">
          <li><span class="check">✓</span> +100 receitas completas</li>
          <li><span class="check">✓</span> Lista de ingredientes</li>
          <li><span class="check">✓</span> Modo de preparo completo</li>
          <li><span class="check">✓</span> Acesso vitalício</li>
          <li><span class="check">✓</span> 20 receitas medicinais</li>
          <li><span class="check">✓</span> Bônus: Guia de Porções</li>
        </ul>
        <a href="#" class="btn btn-primary pricing-btn glow">Quero o Completo</a>
      </div>

      <div class="pricing-card">
        <div class="pricing-header">
          <h3 class="pricing-name">Premium</h3>
          <div class="pricing-price">
            <span class="currency">R$</span>
            <span class="amount">197</span>
            <span class="cents">,90</span>
          </div>
          <span class="pricing-period">Pagamento único</span>
        </div>
        <ul class="pricing-features">
          <li><span class="check">✓</span> +100 receitas completas</li>
          <li><span class="check">✓</span> Tudo do plano Completo</li>
          <li><span class="check">✓</span> Suporte veterinário 30 dias</li>
          <li><span class="check">✓</span> Plano alimentar personalizado</li>
          <li><span class="check">✓</span> Atualizações gratuitas</li>
          <li><span class="check">✓</span> Comunidade exclusiva</li>
        </ul>
        <a href="#" class="btn btn-secondary pricing-btn">Quero o Premium</a>
      </div>
    </div>
    <div class="pricing-guarantee reveal">
      <div class="guarantee-icon">🛡️</div>
      <div>
        <strong>Garantia de 7 dias</strong>
        <p>Se não ficar satisfeito, devolvemos 100% do seu dinheiro. Sem perguntas.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    padding: 8rem 0;
    overflow: hidden;
  }

  .pricing-bg {
    position: absolute;
    inset: 0;
  }

  .pricing-orb-1 {
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.08), transparent 70%);
    border-radius: 50%;
    top: 20%;
    right: -100px;
    filter: blur(60px);
  }

  .pricing-orb-2 {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(251, 191, 36, 0.06), transparent 70%);
    border-radius: 50%;
    bottom: 10%;
    left: -100px;
    filter: blur(60px);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 2;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3rem;
    position: relative;
    z-index: 2;
  }

  .pricing-card {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 1.5rem;
    padding: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .pricing-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  }

  .pricing-card.featured {
    border: 1px solid rgba(34, 197, 94, 0.3);
    transform: scale(1.05);
    z-index: 1;
    background: rgba(34, 197, 94, 0.03);
  }

  .pricing-card.featured:hover {
    transform: scale(1.05) translateY(-8px);
    box-shadow: 0 30px 80px rgba(34, 197, 94, 0.15), 0 0 60px rgba(34, 197, 94, 0.05);
  }

  .featured-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--green-400), var(--amber-400), transparent);
    background-size: 200% 100%;
    animation: gradientShift 3s ease-in-out infinite;
  }

  .pricing-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1.5rem;
    background: linear-gradient(135deg, var(--green-400), var(--green-600));
    color: white;
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: 0.03em;
    box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .pricing-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }

  .pricing-price {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    margin-bottom: 0.25rem;
  }

  .currency {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.5rem;
  }

  .amount {
    font-size: 3.5rem;
    font-weight: 900;
    color: white;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cents {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.5rem;
  }

  .pricing-period {
    display: block;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .original-price {
    display: block;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.3);
    text-decoration: line-through;
    margin-top: 0.25rem;
  }

  .pricing-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .pricing-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .pricing-features li .check {
    font-weight: 700;
    color: var(--green-400);
    font-size: 0.9rem;
  }

  .pricing-features li.disabled {
    color: rgba(255, 255, 255, 0.2);
  }

  .pricing-features li.disabled .check {
    color: rgba(255, 255, 255, 0.15);
  }

  .pricing-btn {
    width: 100%;
  }

  .pricing-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 1.5rem 2rem;
    background: rgba(251, 191, 36, 0.05);
    border: 1px solid rgba(251, 191, 36, 0.1);
    border-radius: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .guarantee-icon {
    font-size: 2.5rem;
  }

  .pricing-guarantee strong {
    display: block;
    color: white;
    margin-bottom: 0.25rem;
  }

  .pricing-guarantee p {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .pricing-card.featured {
      transform: none;
    }

    .pricing-card.featured:hover {
      transform: translateY(-8px);
    }
  }
</style>
