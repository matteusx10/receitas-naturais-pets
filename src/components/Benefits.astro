---
const benefits = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/><path d="M12 6v6l4 2"/></svg>`,
    title: "Ingredientes Naturais",
    description: "Todas as receitas usam ingredientes frescos e naturais, sem conservantes ou aditivos artificiais."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>`,
    title: "Aprovado por Veterinários",
    description: "Cada receita foi revisada e aprovada por uma equipe de 15+ veterinários nutricionistas."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10"/></svg>`,
    title: "Fácil e Rápido",
    description: "Receitas prontas em até 30 minutos, com passos simples que qualquer pessoa segue."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
    title: "Economia Garantida",
    description: "Economize até 60% comparado com rações premium e alimentos industrializados para pets."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    title: "Para Todas as Raças",
    description: "Receitas adaptáveis para cães e gatos de todos os tamanhos, idades e necessidades."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    title: "Saúde em Dia",
    description: "Pelagem mais bonita, mais energia, melhor digestão e sistema imunológico fortalecido."
  }
];
---

<section id="beneficios" class="benefits">
  <div class="benefits-bg">
    <div class="benefits-orb" data-parallax="-0.05"></div>
  </div>
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">✦ Benefícios</span>
      <h2 class="section-title">Por que escolher<br/><span class="gradient-text">receitas naturais?</span></h2>
      <p class="section-subtitle">
        Seu pet merece o melhor. Veja como a alimentação natural pode transformar a vida do seu companheiro.
      </p>
    </div>
    <div class="benefits-grid stagger reveal">
      {benefits.map((benefit) => (
        <div class="benefit-card">
          <div class="benefit-icon" set:html={benefit.icon} />
          <h3 class="benefit-title">{benefit.title}</h3>
          <p class="benefit-description">{benefit.description}</p>
          <div class="benefit-shine"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits {
    position: relative;
    padding: 8rem 0;
    overflow: hidden;
  }

  .benefits-bg {
    position: absolute;
    inset: 0;
  }

  .benefits-orb {
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.06), transparent 70%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(60px);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 2;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .benefit-card {
    position: relative;
    padding: 2rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .benefit-card:hover {
    transform: translateY(-8px);
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(34, 197, 94, 0.2);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2), 0 0 40px rgba(34, 197, 94, 0.05);
  }

  .benefit-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03), transparent);
    transition: left 0.6s;
  }

  .benefit-card:hover .benefit-shine {
    left: 100%;
  }

  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.15);
    border-radius: 1rem;
    color: var(--green-400);
    margin-bottom: 1.25rem;
    transition: all 0.4s;
  }

  .benefit-card:hover .benefit-icon {
    background: rgba(34, 197, 94, 0.15);
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
  }

  .benefit-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.75rem;
  }

  .benefit-description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
