---
const categories = [
  {
    emoji: "🍗",
    title: "Receitas com Carne",
    count: 35,
    items: ["Frango com Abóbora", "Carne com Batata Doce", "Peixe com Legumes"]
  },
  {
    emoji: "🥬",
    title: "Receitas Vegetarianas",
    count: 20,
    items: ["Arcesso de Lentilha", "Bowl Vegano", "Mix de Grãos"]
  },
  {
    emoji: "🎂",
    title: "Petiscos & Biscoitos",
    count: 25,
    items: ["Biscoito de Amendoim", "Frozen de Banana", "Jerky Natural"]
  },
  {
    emoji: "💊",
    title: "Receitas Medicinais",
    count: 20,
    items: ["Para Digestão", "Para Pelagem", "Para Articulações"]
  }
];
---

<section id="receitas" class="recipes">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">📖 Receitas</span>
      <h2 class="section-title">Mais de 100 receitas para explorar</h2>
      <p class="section-subtitle">
        Categorias variadas para atender todas as necessidades do seu pet, desde o dia a dia até situações especiais.
      </p>
    </div>
    <div class="recipes-grid">
      {categories.map((cat) => (
        <div class="recipe-card">
          <div class="recipe-header">
            <span class="recipe-emoji">{cat.emoji}</span>
            <span class="recipe-count">{cat.count} receitas</span>
          </div>
          <h3 class="recipe-title">{cat.title}</h3>
          <ul class="recipe-list">
            {cat.items.map((item) => (
              <li>
                <span class="check">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <div class="recipe-more">+ muitas outras</div>
        </div>
      ))}
    </div>
    <div class="recipes-cta">
      <p>Todas as receitas incluem lista de ingredientes, modo de preparo, porções e informações nutricionais.</p>
    </div>
  </div>
</section>

<style>
  .recipes {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--warm-50) 0%, white 100%);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .recipe-card {
    background: white;
    border-radius: 1.25rem;
    padding: 2rem;
    border: 1px solid var(--gray-100);
    transition: all 0.3s ease;
  }

  .recipe-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08);
    border-color: var(--green-200);
  }

  .recipe-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .recipe-emoji {
    font-size: 2.5rem;
  }

  .recipe-count {
    padding: 0.375rem 0.75rem;
    background: var(--green-100);
    color: var(--green-700);
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .recipe-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 1rem;
  }

  .recipe-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }

  .recipe-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--gray-600);
  }

  .check {
    color: var(--green-500);
    font-weight: 700;
  }

  .recipe-more {
    font-size: 0.8rem;
    color: var(--gray-400);
    font-style: italic;
  }

  .recipes-cta {
    text-align: center;
    padding: 2rem;
    background: var(--green-50);
    border-radius: 1rem;
    border: 1px solid var(--green-100);
  }

  .recipes-cta p {
    color: var(--green-700);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .recipes-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .recipes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
